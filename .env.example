# Salin ke .env untuk penggunaan lokal; jangan commit nilai rahasia.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/pems_db
PEMS_IMPORT_API_KEY=ganti-dengan-random-string-panjang
PEMS_IMPORT_USER=web-user
PEMS_COOKIE_SECURE=false
PEMS_SESSION_TTL_SECONDS=28800
# Hanya untuk menjalankan scripts/bootstrap_admin.py secara manual; jangan diisi di source.
PEMS_ADMIN_USERNAME=admin_utama
PEMS_ADMIN_PASSWORD=isi-password-kuat-minimal-12-karakter
